# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- MySQL ---
MYSQL_HOST=localhost
# 3307 (not the default 3306) so this project's Dockerized MySQL doesn't clash with any
# MySQL server already installed/running locally on the default port.
MYSQL_PORT=3307
MYSQL_USER=kandumas
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=kandumas_db
MYSQL_ROOT_PASSWORD=change-me-root

# SQLAlchemy connection string built from the above by backend/app/core/config.py.
# Override directly if you want to point at a different DB:
# DATABASE_URL=mysql+pymysql://kandumas:change-me@localhost:3306/kandumas_db

# --- Backend/API ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Demo seeded accounts (created by seed.py) ---
DEMO_ADMIN_PASSWORD=Admin123!
DEMO_OFFICER_PASSWORD=Officer123!
DEMO_FISHERMAN_PASSWORD=Fisherman123!

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
